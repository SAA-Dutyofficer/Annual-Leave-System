rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isManager() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isManager();
    }

    match /employees/{uid} {
      allow read: if isAuth();
      // Staff can update their own employee record (for self-renewal)
      allow update: if isAuth() && (request.auth.uid == uid || isManager());
      allow create, delete: if isManager();
    }

    match /leaveRequests/{reqId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update: if isAuth() && (
        resource.data.employeeId == request.auth.uid ||
        isManager()
      );
      allow delete: if isManager();
    }

    match /groups/{groupId} {
      allow read: if isAuth();
      allow write: if isManager();
    }

    match /cycleHistory/{docId} {
      allow read: if isAuth();
      // Staff can create their own cycle history (self-renewal)
      allow create: if isAuth();
      allow update, delete: if isManager();
    }

    match /auditLog/{docId} {
      allow read: if isManager();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    match /emailQueue/{docId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }
  }
}
