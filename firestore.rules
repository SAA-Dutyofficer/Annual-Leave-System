rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isManager() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read:  if isAuth() && (isOwner(uid) || isManager());
      allow write: if isManager();
    }

    match /employees/{uid} {
      allow read:  if isAuth() && (isOwner(uid) || isManager());
      allow write: if isManager();
    }

    match /leaveRequests/{reqId} {
      allow create: if isAuth();
      allow read:   if isAuth() && (resource.data.employeeId == request.auth.uid || isManager());
      allow update: if isAuth() && (
        (resource.data.employeeId == request.auth.uid && resource.data.status == 'Pending') ||
        isManager()
      );
      allow delete: if isManager();
    }

    match /groups/{groupId} {
      allow read:  if isAuth();
      allow write: if isManager();
    }

    match /cycleHistory/{docId} {
      allow read:  if isAuth() && (resource.data.employeeId == request.auth.uid || isManager());
      allow write: if isManager();
    }

    match /auditLog/{docId} {
      allow read:  if isManager();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    match /emailQueue/{docId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }
  }
}
